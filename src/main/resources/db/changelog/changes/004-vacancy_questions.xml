<?xml version="1.1" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ===================== krrg_vacancy_questions : table ===================== -->
    <changeSet id="004-01-table-vacancy-questions" author="krtg">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="krrg_vacancy_questions"/></not>
        </preConditions>

        <createTable tableName="krrg_vacancy_questions">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="text" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="question_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="required" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- ================ krrg_vacancy_question_options : table ================ -->
    <changeSet id="004-02-table-vacancy-question-options" author="krtg">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="krrg_vacancy_question_options"/></not>
        </preConditions>

        <createTable tableName="krrg_vacancy_question_options">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="question_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="value" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="sort_order" type="INT"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- krrg_vacancy_question_options : FK -> krrg_vacancy_questions -->
    <changeSet id="004-03-fk-vacancy-question-options-question" author="krtg">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyTableName="krrg_vacancy_question_options"
                                            foreignKeyName="fk_vacancy_question_options__question"/>
            </not>
        </preConditions>

        <addForeignKeyConstraint
                baseTableName="krrg_vacancy_question_options"
                baseColumnNames="question_id"
                constraintName="fk_vacancy_question_options__question"
                referencedTableName="krrg_vacancy_questions"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

    <!-- krrg_vacancy_question_options : index on question_id -->
    <changeSet id="004-04-idx-vacancy-question-options-question-id" author="krtg">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="krrg_vacancy_question_options"
                             indexName="idx_vacancy_question_options__question_id"/>
            </not>
        </preConditions>

        <createIndex indexName="idx_vacancy_question_options__question_id"
                     tableName="krrg_vacancy_question_options">
            <column name="question_id"/>
        </createIndex>
    </changeSet>

    <!-- ================ krrg_vacancy_question_answers : table ================ -->
    <changeSet id="004-05-table-vacancy-question-answers" author="krtg">
