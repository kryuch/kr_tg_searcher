<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- 1. Увеличить все не-NULL значения status на 1 -->
    <changeSet id="014-001-increment-chat-status" author="Oleg V. Kryuchin">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="krrg_chats"/>
            <columnExists tableName="krrg_chats" columnName="status"/>
        </preConditions>
        <sql splitStatements="false"><![CDATA[
            UPDATE krrg_chats
            SET status = status + 1
            WHERE status IS NOT NULL;
            ]]></sql>
        <rollback>
            <sql splitStatements="false"><![CDATA[
                UPDATE krrg_chats
                SET status = status - 1
                WHERE status IS NOT NULL;
            ]]></sql>
        </rollback>
    </changeSet>

</databaseChangeLog>