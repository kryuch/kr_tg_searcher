<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="019-001-create-krrg-employee-education-table" author="Kvashenkin D.">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="krrg_employee_educations"/>
            </not>
        </preConditions>
        <sql splitStatements="false"><![CDATA[
            CREATE TABLE krrg_employee_educations (
            id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
            university VARCHAR(100) NOT NULL,
            education_type VARCHAR(100) NOT NULL,
            start_year INTEGER,
            end_year INTEGER,
            specialty VARCHAR(100) NOT NULL,
            );
        ]]></sql>
        <rollback>
            <sql splitStatements="false"><![CDATA[
                DROP TABLE IF EXISTS krrg_employee_educations;
            ]]></sql>
        </rollback>
    </changeSet>
</databaseChangeLog>
