    <!-- 5. Таблица учёных степеней -->
    <changeSet id="021-005-create-education-degrees" author="Oleg V. Kryuchin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="krrg_education_degrees"/>
            </not>
        </preConditions>
        <sql splitStatements="false"><![CDATA[
            CREATE TABLE krrg_education_degrees (
                                                    id   BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
                                                    code VARCHAR(20) NOT NULL,
                                                    name VARCHAR(255) NOT NULL,
                                                    CONSTRAINT uk_education_degrees__code UNIQUE (code)
            );
            ]]></sql>
        <rollback>
            <sql splitStatements="false"><![CDATA[
                DROP TABLE IF EXISTS krrg_education_degrees;
            ]]></sql>
        </rollback>
    </changeSet>

    <!-- 6. Добавление degree_id в krrg_employee_educations -->
    <changeSet id="021-006-add-degree-id-to-educations" author="Oleg V. Kryuchin">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="krrg_employee_educations"/>
                <tableExists tableName="krrg_education_degrees"/>
                <not>
                    <columnExists tableName="krrg_employee_educations" columnName="degree_id"/>
                </not>
            </and>
        </preConditions>
        <sql splitStatements="false"><![CDATA[
            ALTER TABLE krrg_employee_educations ADD COLUMN degree_id BIGINT;
            ALTER TABLE krrg_employee_educations
                ADD CONSTRAINT fk_employee_educations__degree
                    FOREIGN KEY (degree_id) REFERENCES krrg_education_degrees(id) ON DELETE RESTRICT;
            CREATE INDEX IF NOT EXISTS idx_employee_educations__degree_id
                ON krrg_employee_educations (degree_id);
            ]]></sql>
        <rollback>
            <sql splitStatements="false"><![CDATA[
                ALTER TABLE krrg_employee_educations DROP CONSTRAINT IF EXISTS fk_employee_educations__degree;
                ALTER TABLE krrg_employee_educations DROP COLUMN IF EXISTS degree_id;
            ]]></sql>
        </rollback>
    </changeSet>

    <!-- 7. Заполнение справочника учёных степеней -->
    <changeSet id="021-007-insert-education-degrees" author="Oleg V. Kryuchin">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="krrg_education_degrees"/>
                <columnExists tableName="krrg_education_degrees" columnName="code"/>
            </and>
        </preConditions>
        <sql splitStatements="false"><![CDATA[
            INSERT INTO krrg_education_degrees (code, name)
            VALUES
                ('BACHELOR', 'Бакалавр'),
                ('SPECIALIST', 'Специалист'),
                ('MASTER', 'Магистр'),
                ('CANDIDATE', 'Кандидат наук'),
                ('DOCTOR', 'Доктор наук')
                ON CONFLICT (code) DO NOTHING;
            ]]></sql>
        <rollback>
            <sql splitStatements="false"><![CDATA[
                DELETE FROM krrg_education_degrees
                WHERE code IN ('BACHELOR', 'SPECIALIST', 'MASTER', 'CANDIDATE', 'DOCTOR');
            ]]></sql>
        </rollback>
    </changeSet>
</databaseChangeLog>