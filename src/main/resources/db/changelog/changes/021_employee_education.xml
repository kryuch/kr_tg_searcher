<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- 1. Добавление code в krrg_education_types -->
    <changeSet id="021-001-add-code-to-education-types" author="Oleg V. Kryuchin">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="krrg_education_types"/>
                <not>
                    <columnExists tableName="krrg_education_types" columnName="code"/>
                </not>
            </and>
        </preConditions>
        <sql splitStatements="false"><![CDATA[
            ALTER TABLE krrg_education_types ADD COLUMN code VARCHAR(20);
            ]]></sql>
        <rollback>
            <sql splitStatements="false"><![CDATA[
                ALTER TABLE krrg_education_types DROP COLUMN IF EXISTS code;
            ]]></sql>
        </rollback>
    </changeSet>

    <!-- 1a. Уникальное ограничение на code -->
    <changeSet id="021-001a-add-unique-code-to-education-types" author="Oleg V. Kryuchin">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="krrg_education_types"/>
                <columnExists tableName="krrg_education_types" columnName="code"/>
                <not>
                    <uniqueConstraintExists tableName="krrg_education_types"
                                            constraintName="uk_education_type__code"/>
                </not>
            </and>
        </preConditions>
        <sql splitStatements="false"><![CDATA[
            ALTER TABLE krrg_education_types
                ADD CONSTRAINT uk_education_type__code UNIQUE (code);
            ]]></sql>
        <rollback>
            <sql splitStatements="false"><![CDATA[
                ALTER TABLE krrg_education_types
                    DROP CONSTRAINT IF EXISTS uk_education_type__code;
            ]]></sql>
        </rollback>
    </changeSet>

    <!-- 2. Заполнение справочника типов обучения -->
    <changeSet id="021-002-insert-education-types" author="Oleg V. Kryuchin">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="krrg_education_types"/>
                <columnExists tableName="krrg_education_types" columnName="code"/>
            </and>
        </preConditions>
        <sql splitStatements="false"><![CDATA[
            INSERT INTO krrg_education_types (code, name)
            VALUES
                ('FULL_TIME', 'Очная'),
                ('PART_TIME', 'Заочная'),
                ('DISTANCE',  'Дистанционная'),
                ('EVENING',   'Вечерняя')
                ON CONFLICT (code) DO NOTHING;
            ]]></sql>
        <rollback>
            <sql splitStatements="false"><![CDATA[
                DELETE FROM krrg_education_types
                WHERE code IN ('FULL_TIME', 'PART_TIME', 'DISTANCE', 'EVENING');
            ]]></sql>
        </rollback>
    </changeSet>

