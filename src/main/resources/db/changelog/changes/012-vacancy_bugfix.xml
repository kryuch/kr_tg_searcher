<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- 1. Снимаем NOT NULL с user_id в krrg_vacancies, если он там есть -->
    <changeSet id="012-001-drop-not-null-user-id-from-vacancies" author="Oleg V. Kryuchin">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="krrg_vacancies"/>
                <columnExists tableName="krrg_vacancies" columnName="user_id"/>
                <sqlCheck expectedResult="1">
                    SELECT COUNT(*)
                    FROM information_schema.columns
                    WHERE table_name = 'krrg_vacancies'
                    AND column_name = 'user_id'
                    AND is_nullable = 'NO'
                </sqlCheck>
            </and>
        </preConditions>
        <sql><![CDATA[
            ALTER TABLE krrg_vacancies ALTER COLUMN user_id DROP NOT NULL;
            ]]></sql>
        <rollback>
            <sql><![CDATA[
                -- Откат вернёт NOT NULL. Если в таблице есть NULL-значения, откат упадёт.
                ALTER TABLE krrg_vacancies ALTER COLUMN user_id SET NOT NULL;
            ]]></sql>
        </rollback>
    </changeSet>

</databaseChangeLog>