<?xml version="1.1" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="007-01-deepseek_add_application_column" author="Oleg V. Kryuchin">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="krrg_api_tokens"/>
                <not>
                    <columnExists tableName="krrg_api_tokens" columnName="application"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="krrg_api_tokens">
            <column name="application" type="VARCHAR(32)" defaultValue="hh">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="007-02-deepseek_add_deepseek_record" author="Oleg V. Kryuchin">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="krrg_setting_groups"/>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM krrg_setting_groups WHERE code = 'deepseek'
                </sqlCheck>
            </and>
        </preConditions>
        <insert tableName="krrg_setting_groups">
            <column name="code" value="deepseek"/>
            <column name="title" value="DeepSeek"/>
            <column name="is_active" value="true"/>
            <column name="sort_order" valueNumeric="100"/>
            <column name="created_at" valueDate="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueDate="CURRENT_TIMESTAMP"/>
        </insert>
        <rollback>
            <delete tableName="krrg_setting_groups">
                <where>code = 'deepseek'</where>
            </delete>
        </rollback>
    </changeSet>

    <changeSet id="007-03-deepseek_add_deepseek_enable" author="Oleg V. Kryuchin">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="krrg_settings"/>
                <tableExists tableName="krrg_setting_groups"/>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM krrg_settings WHERE code = 'deepseek_enable'
                </sqlCheck>
                <sqlCheck expectedResult="1">
                    SELECT COUNT(*) FROM krrg_setting_groups WHERE code = 'deepseek'
                </sqlCheck>
            </and>
        </preConditions>
        <insert tableName="krrg_settings">
            <column name="code" value="deepseek_enable"/>
            <column name="title" value="Включено"/>
            <column name="group_id" valueComputed="(SELECT id FROM krrg_setting_groups WHERE code = 'deepseek')"/>
            <column name="setting_type" value="BOOLEAN"/>
            <column name="sort_order" valueNumeric="1"/>
            <column name="is_large" value="false"/>
            <column name="created_at" valueDate="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueDate="CURRENT_TIMESTAMP"/>
        </insert>
        <rollback>
            <delete tableName="krrg_settings">
                <where>code = 'deepseek_enable'</where>
            </delete>
        </rollback>
    </changeSet>

    <changeSet id="007-04-deepseek_add_deepseek_seconds_interval" author="Oleg V. Kryuchin">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="krrg_settings"/>
                <tableExists tableName="krrg_setting_groups"/>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM krrg_settings WHERE code = 'deepseek_pause'
                </sqlCheck>
                <sqlCheck expectedResult="1">
                    SELECT COUNT(*) FROM krrg_setting_groups WHERE code = 'deepseek'
                </sqlCheck>
            </and>
        </preConditions>
        <insert tableName="krrg_settings">
            <column name="code" value="deepseek_pause"/>
            <column name="title" value="Интервал запроса"/>
            <column name="group_id" valueComputed="(SELECT id FROM krrg_setting_groups WHERE code = 'deepseek')"/>
            <column name="setting_type" value="INTEGER"/>
            <column name="sort_order" valueNumeric="2"/>
            <column name="is_large" value="false"/>
            <column name="created_at" valueDate="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueDate="CURRENT_TIMESTAMP"/>
        </insert>
        <rollback>
            <delete tableName="krrg_settings">
                <where>code = 'deepseek_pause'</where>
            </delete>
        </rollback>
    </changeSet>

    <changeSet id="007-05-deepseek_create_group_table" author="Oleg V. Kryuchin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="krrg_deepseek_tasks_group"/>
            </not>
        </preConditions>
        <createTable tableName="krrg_deepseek_tasks_group">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="is_busy" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <rollback>
            <dropTable tableName="krrg_deepseek_tasks_group" cascadeConstraints="true"/>
        </rollback>
    </changeSet>

    <changeSet id="007-06-deepseek_create_group_index" author="Oleg V. Kryuchin">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="krrg_deepseek_tasks_group"/>
                <not>
                    <indexExists tableName="krrg_deepseek_tasks_group" indexName="idx_deepseek_tasks_group_user_id"/>
                </not>
            </and>
        </preConditions>
        <createIndex indexName="idx_deepseek_tasks_group_user_id"
                     tableName="krrg_deepseek_tasks_group">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="007-07-deepseek_create_task_table" author="Oleg V. Kryuchin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="krrg_deepseek_task"/>
            </not>
        </preConditions>
        <createTable tableName="krrg_deepseek_task">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="result" type="TEXT"/>
            <column name="is_done" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>
            <column name="group_id" type="INT"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <rollback>
            <dropTable tableName="krrg_deepseek_task" cascadeConstraints="true"/>
        </rollback>
    </changeSet>

    <changeSet id="007-08-deepseek_create_keys" author="Oleg V. Kryuchin">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="krrg_deepseek_task"/>
                <tableExists tableName="krrg_deepseek_tasks_group"/>
                <columnExists tableName="krrg_deepseek_task" columnName="group_id"/>
                <not>
                    <foreignKeyConstraintExists foreignKeyTableName="krrg_deepseek_task"
                                                foreignKeyName="fk_deepseek_task__group"/>
                </not>
            </and>
        </preConditions>
        <addForeignKeyConstraint
                baseTableName="krrg_deepseek_task"
                baseColumnNames="group_id"
                constraintName="fk_deepseek_task__group"
                referencedTableName="krrg_deepseek_tasks_group"
                referencedColumnNames="id"
                onDelete="SET NULL"/>
    </changeSet>

    <changeSet id="007-09-deepseek_create_keys" author="Oleg V. Kryuchin">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="krrg_deepseek_task"/>
                <columnExists tableName="krrg_deepseek_task" columnName="group_id"/>
                <not>
                    <indexExists tableName="krrg_deepseek_task" indexName="idx_deepseek_task_group_id"/>
                </not>
            </and>
        </preConditions>
        <createIndex indexName="idx_deepseek_task_group_id"
                     tableName="krrg_deepseek_task">
            <column name="group_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="007-10-deepseek_create_keys" author="Oleg V. Kryuchin">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="krrg_deepseek_task"/>
                <columnExists tableName="krrg_deepseek_task" columnName="is_done"/>
                <not>
                    <indexExists tableName="krrg_deepseek_task" indexName="idx_deepseek_task_is_done"/>
                </not>
            </and>
        </preConditions>
        <createIndex indexName="idx_deepseek_task_is_done"
                     tableName="krrg_deepseek_task">
            <column name="is_done"/>
        </createIndex>
    </changeSet>

    <changeSet id="007-11-deepseek_status" author="Oleg V. Kryuchin">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="krrg_deepseek_task"/>
                <not>
                    <columnExists tableName="krrg_deepseek_task" columnName="status"/>
                </not>
                <not>
                    <columnExists tableName="krrg_deepseek_task" columnName="error"/>
                </not>
            </and>
        </preConditions>
        <sql><![CDATA[
            ALTER TABLE krrg_deepseek_task ADD COLUMN IF NOT EXISTS status VARCHAR(64) DEFAULT 'NEW';
            ALTER TABLE krrg_deepseek_task ADD COLUMN IF NOT EXISTS error VARCHAR(1024);
            ]]></sql>
        <rollback>
            <sql><![CDATA[
                ALTER TABLE krrg_deepseek_task DROP COLUMN IF EXISTS status;
                ALTER TABLE krrg_deepseek_task DROP COLUMN IF EXISTS error;
            ]]></sql>
        </rollback>
    </changeSet>

