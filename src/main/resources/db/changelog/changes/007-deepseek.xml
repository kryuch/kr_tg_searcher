    <changeSet id="007-14-deepseek_setting_value_type_for_resume" author="Oleg V. Kryuchin">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="krrg_setting_values"/>
                <columnExists tableName="krrg_setting_values" columnName="string_value"/>
                <not>
                    <sqlCheck expectedResult="1">
                        SELECT COUNT(*)
                        FROM information_schema.columns
                        WHERE table_name = 'krrg_setting_values'
                        AND column_name = 'string_value'
                        AND data_type = 'text'
                    </sqlCheck>
                </not>
            </and>
        </preConditions>
        <sql><![CDATA[
            ALTER TABLE krrg_setting_values
            ALTER COLUMN string_value TYPE TEXT;
            ]]></sql>
        <rollback>
            <sql><![CDATA[
                ALTER TABLE krrg_setting_values
                ALTER COLUMN string_value TYPE VARCHAR(255);
            ]]></sql>
        </rollback>
    </changeSet>

